# pr-review 审查配置示例:复制为仓库根 .ai-review.yaml(或在 Action 中用 config-path 指定)。
# 所有项均可省略,缺省用内置默认值。哲学:先 chill,控制噪音,再逐步收紧。

# 审查重点(直接作为指令进入 prompt,按重要度排序)
review_focus:
  - "bug 与逻辑错误"
  - "并发/性能隐患"
  - "安全问题(注入/越权/密钥泄露)"
  - "资源泄漏(连接/文件未关闭)"
  - "明显不符合项目既有约定(命名/分层/异常处理)"

# 忽略的路径(glob 匹配,** 递归)。锁文件/构建产物/生成代码通常不需要审。
ignore_paths:
  - "**/*.lock"
  - "**/package-lock.json"
  - "**/pnpm-lock.yaml"
  - "**/yarn.lock"
  - "**/go.sum"
  - "**/*.min.js"
  - "**/*.min.css"
  - "**/vendor/**"
  - "**/generated/**"
  - "**/dist/**"
  - "**/build/**"
  - "**/target/**"
  - "**/api/mocks/**"
  - "**/.idea/**"
  - "**/.vscode/**"

# 只发出达到该级别及以上的问题(error > warn > info)。初版建议 warn,嫌吵改 error。
min_severity: "warn"

# 合并门禁:存在达到该级别及以上的问题时, check-run 失败 + job exit 1(PR 变红)
#   error: 只有 error 拦(推荐) | warn: warn 也拦 | off: 永不拦(只发评论)
# 注意: AI 标记 needs_review(需人工确认)的问题不计入门禁,避免误报阻塞合并。
# 配合 GitHub 分支保护规则"Require status checks"勾选 AI Review 即可阻止合并。
fail_on_severity: "error"

# 仓库上下文:审查前收集这些文件(glob,相对仓库根)注入 prompt,
# 让 AI 结合项目约定/API 契约判断(显著降低"设计意图类"误报)。
# 按顺序累计, 总预算 max_context_chars, 超预算截断。
context_files:
  - "AGENTS.md"
  - "README.md"
  - "docs/**/*.md"
  - "spec/**"
max_context_chars: 8000

# 生成代码检测:文件头含 Generated by/@generated/DO NOT EDIT 标记的自动跳过审查
ignore_generated: true

# 线程决议驱动(P1a):用户在线程表态(已解决/设计意图/忽略)后,下轮 review 不再重复报。
#   AI 回复会附带隐藏标记,下轮扫描线程提取"已处理清单"注入 prompt + 确定性过滤。
resolve_enabled: true
# 已处理清单注入上限条数
max_handled_lines: 200

# 质量门(P1b):审查完成后 judge 打分,不达标带反馈整批重写,仍不达标降级
#   (发说明评论 + check neutral, 不拦合并)。详设: docs/pr-review-quality-gate.md
quality_gate:
  enabled: true          # 一键开关; 关闭则跳过 judge 与重写
  judge_model: ""        # judge 用模型; 留空=与审查同模型
  judge_provider: ""     # judge 用 provider; 留空=与审查同 provider(模型路由: 审查用强模型, judge 可用便宜模型)
  pass_score: 70         # 低于则触发重写
  max_rewrites: 3        # 重写硬上限, 耗尽后降级
  max_judge_input_chars: 8000  # judge 输入预算(大 PR 截断)
  # linter 交叉验证层: 首版预留, 未实现(需工作流安装对应 linter)
  lint_enabled: false
  lint_only: [py, go, js]

# 切片:大 PR 按批审,控制单次 prompt token 与成本
max_files_per_batch: 20

# 单文件 patch 超过该行数则截断(评论中会提示)
max_lines_per_file: 800

# 评论末尾是否附带模型/token/成本统计
show_stats: true
